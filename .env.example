# ── Obligatorias ──────────────────────────────────────────────────────────────
# Solo testnet. El proceso se niega a arrancar con cualquier otro valor.
NETWORK=testnet
# Clave S… del admin del protocolo (deployments.admin = GBLS7PL5…). NUNCA al repo.
# En local: RELAYER_ADMIN_SECRET=$(stellar keys show raiz-admin)
RELAYER_ADMIN_SECRET=
# API key estática que envía la app en el header x-raiz-app-key (≥16 chars).
# Genera una: openssl rand -hex 24
RELAYER_APP_KEY=

# ── Opcionales (defaults entre paréntesis) ────────────────────────────────────
# RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# PORT=8080
# HOST=0.0.0.0
# FAUCET_AMOUNT_STROOPS=200000000        # 20 USDC (7 decimales)
# RATE_FAUCET_PER_ADDRESS_MINUTES=10     # 1 faucet por address cada 10 min
# RATE_FAUCET_DAILY=50                   # cupo diario global del faucet
# RATE_REGISTER_DAILY=20
# RATE_MINT_DAILY=20
# RATE_VAULT_DAILY=20
# RATE_PER_IP_PER_MINUTE=60
# VAULT_ENDPOINTS_ENABLED=true           # /v1/vault/* (pantalla Yield); false → 404
# LOG_LEVEL=info
# DEPLOYMENTS_FILE=config/deployments.testnet.json
# QUEUE_CAP=20
# JOB_DEADLINE_MS=75000
# JOB_TIMEOUT_MS=90000
# SUBMIT_ATTEMPTS=5
# SUBMIT_BACKOFF_MS=3000
# TX_TIMEOUT_SECONDS=30
# IDEMPOTENCY_TTL_MS=600000
# HEALTH_CACHE_MS=10000
