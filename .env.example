# ── Obligatorias ──────────────────────────────────────────────────────────────
# Solo testnet. El proceso se niega a arrancar con cualquier otro valor.
NETWORK=testnet
# Clave S… con la que FIRMA el relayer: la maestra de la cuenta admin o un firmante
# autorizado de ella. La CUENTA es siempre deployments.admin (GBLS7PL5…) y no sale de
# aquí; al arrancar se comprueba on-chain que esta clave puede firmar por esa cuenta
# (si no puede, el proceso no arranca). Desde la rotación del 2026-10-04 la maestra
# tiene peso 0 y firma el firmante de la identidad `raiz-admin-signer`. NUNCA al repo.
# En local: RELAYER_ADMIN_SECRET=$(stellar keys show raiz-admin-signer)
RELAYER_ADMIN_SECRET=
# (No hay API key: RELAYER_APP_KEY se eliminó en la 0.3.0. Si sigue definida se
# ignora y el arranque escribe un warn; el relayer es público, acotado por cupos.)

# ── Opcionales (defaults entre paréntesis) ────────────────────────────────────
# RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# PORT=8080
# HOST=0.0.0.0
# FAUCET_AMOUNT_STROOPS=200000000        # 20 USDC (7 decimales)
# RATE_FAUCET_PER_ADDRESS_MINUTES=10     # 1 faucet por address cada 10 min
# RATE_FAUCET_DAILY=50                   # cupo diario global del faucet
# RATE_REGISTER_DAILY=20
# RATE_MINT_DAILY=20
# RATE_VAULT_DAILY=20
# RATE_PER_IP_PER_MINUTE=60
# Cupos diarios POR IP de los POST (día UTC; misma clave de IP que el limitador por
# minuto). Súbelos para un evento con muchos teléfonos detrás de la misma IP.
# FAUCET_PER_IP_DAILY=10
# REGISTER_PER_IP_DAILY=10
# MINT_PER_IP_DAILY=10
# VAULT_PER_IP_DAILY=20                  # deposit + redeem juntos
# VAULT_ENDPOINTS_ENABLED=true           # /v1/vault/* (pantalla Yield); false → 404
# LOG_LEVEL=info
# DEPLOYMENTS_FILE=config/deployments.testnet.json
# QUEUE_CAP=20
# Regla: JOB_TIMEOUT_MS >= JOB_DEADLINE_MS + RPC_REQUEST_TIMEOUT_MS + 5000
# (el submit solo inicia una llamada RPC si le quedan > RPC_REQUEST_TIMEOUT_MS
# de deadline, así que acaba como muy tarde en deadline + timeout; la cola
# debe cubrirlo con margen o respondería TX_TIMEOUT con el job aún vivo).
# JOB_DEADLINE_MS=70000
# JOB_TIMEOUT_MS=90000
# RPC_REQUEST_TIMEOUT_MS=15000          # timeout HTTP por petición (RPC y Horizon)
# SUBMIT_ATTEMPTS=5
# SUBMIT_BACKOFF_MS=3000
# TX_TIMEOUT_SECONDS=30
# IDEMPOTENCY_TTL_MS=600000
# HEALTH_CACHE_MS=10000
