{
  "name": "raiz-relayer",
  "version": "0.1.0",
  "description": "Admin relayer de RAÍZ: firma server-side los flujos admin (registro de comercios, soulbound de residentes, faucet USDC, vault) en Stellar testnet.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:it": "cross-env RELAYER_IT=1 vitest run test/integration"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "cross-env": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
